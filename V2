section("TELEPORT PLAYER")

local TargetInput = inputBox("Masukkan username pemain")

local function teleportPlayer()
    local username = TargetInput.Text:lower()

    if username == "" then return end

    local target

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and
            player.Name:lower():sub(1,#username) == username then
            target = player
            break
        end
    end

    if not target then
        TargetInput.Text = "Player tidak ditemukan"
        return
    end

    local targetChar = target.Character
    local myChar = LP.Character

    local targetRoot = targetChar and
        targetChar:FindFirstChild("HumanoidRootPart")

    local myRoot = myChar and
        myChar:FindFirstChild("HumanoidRootPart")

    if targetRoot and myRoot then
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0,0,3)
    end
end


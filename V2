section("PLAYER VISUAL")

local ESP = false

local function removeESP(player)
    if player.Character then
        for _, obj in ipairs(player.Character:GetDescendants()) do
            if obj.Name == "DeltaHighlight"
            or obj.Name == "DeltaName" then
                obj:Destroy()
            end
        end
    end
end

local function applyESP(player)
    if not ESP or player == LP then return end

    local char = player.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    if not head then return end

    if not char:FindFirstChild("DeltaHighlight") then
        local h = Instance.new("Highlight")
        h.Name = "DeltaHighlight"
        h.FillColor = Purple
        h.OutlineColor = Color3.new(1,1,1)
        h.Parent = char
    end

    if not head:FindFirstChild("DeltaName") then
        local tag = Instance.new("BillboardGui")
        tag.Name = "DeltaName"
        tag.Size = UDim2.fromOffset(180, 35)
        tag.StudsOffset = Vector3.new(0, 2.5, 0)
        tag.AlwaysOnTop = true
        tag.Parent = head

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1,1)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(210,150,255)
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = tag

        task.spawn(function()
            while tag.Parent do
                local targetHead = player.Character
                    and player.Character:FindFirstChild("Head")

                if targetHead then
                    local distance = (Camera.CFrame.Position -
                        targetHead.Position).Magnitude

                    label.Text = player.Name .. " [" ..
                        math.floor(distance) .. "m]"
                end

                task.wait(0.2)
            end
        end)
    end
end

button("PLAYER ESP", function(value)
    ESP = value

    for _, player in ipairs(Players:GetPlayers()) do
        if value then
            applyESP(player)
        else
            removeESP(player)
        end
    end
end)

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(1)
        applyESP(player)
    end)
end)

Players.PlayerRemoving:Connect(removeESP)

